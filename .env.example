RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=

# --- Bezo AI chat widget ---
GEMINI_API_KEY=

# --- Analytics (optional) ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=

# --- Google AdSense (optional) ---
# Your "ca-pub-xxxxxxxxxxxxxxxx" client ID from the AdSense dashboard.
# Once set, this single value drives three things automatically:
#   1. <meta name="google-adsense-account"> on every page (site ownership signal)
#   2. The adsbygoogle.js loader script (only loads after a visitor accepts
#      advertising cookies in the cookie-consent banner)
#   3. /ads.txt (served dynamically at app/ads.txt/route.ts)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
